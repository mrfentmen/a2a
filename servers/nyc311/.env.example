# NYC 311 A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8787
# URL clients use to reach this server; embedded in the agent card.
# Set this whenever A2A_HOST=0.0.0.0 or you are behind a proxy.
A2A_PUBLIC_URL=http://127.0.0.1:8787
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- dataset access ----------------------------------------------------------
# Optional Socrata app token; raises rate limits, not required for light use.
NYC311_APP_TOKEN=
NYC311_BASE_URL=https://data.cityofnewyork.us
NYC311_CACHE_TTL=60
NYC311_HTTP_TIMEOUT=20

# --- state -------------------------------------------------------------------
NYC311_DB=./servers/nyc311/data/tasks.db
# Seconds between webhook watches. Minimum enforced value is 5.
NYC311_WATCH_INTERVAL=300
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
NYC311_ALLOW_PRIVATE_WEBHOOKS=0
