# Interagency wildfire (NIFC WFIGS) A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8795
A2A_PUBLIC_URL=http://127.0.0.1:8795
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# NIFC's ArcGIS service needs no key; this is just how you identify yourself.
FIRE_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
FIRE_BASE_URL=https://services3.arcgis.com/T4QMspbfLg3qTGWY/arcgis/rest/services
# Incidence lists change as agencies report, so a short cache is fine.
FIRE_CACHE_TTL=300
FIRE_HTTP_TIMEOUT=30

# --- state -------------------------------------------------------------------
FIRE_DB=./servers/fire/data/tasks.db
# Fire perimeters and acreage move slowly; 600s polls without hammering NIFC.
FIRE_WATCH_INTERVAL=600
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
FIRE_ALLOW_PRIVATE_WEBHOOKS=0
