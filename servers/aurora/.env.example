# NOAA space weather (aurora) A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8794
A2A_PUBLIC_URL=http://127.0.0.1:8794
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# SWPC asks callers to identify themselves; override with your own contact URL.
AURORA_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
AURORA_BASE_URL=https://services.swpc.noaa.gov
AURORA_CACHE_TTL=300
AURORA_HTTP_TIMEOUT=20

# --- state -------------------------------------------------------------------
AURORA_DB=./servers/aurora/data/tasks.db
# The 1-minute Kp estimate moves every minute; 300s polls without hammering SWPC.
AURORA_WATCH_INTERVAL=300
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
AURORA_ALLOW_PRIVATE_WEBHOOKS=0
