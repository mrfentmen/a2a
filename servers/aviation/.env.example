[TEMPLATE]
# Aviation weather (METAR + TAF) A2A server — copy to .env and export, or pass real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8802
A2A_PUBLIC_URL=http://127.0.0.1:8802
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# The Aviation Weather Center needs no key; this is just how you identify yourself.
AVIATION_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
AVIATION_BASE_URL=https://aviationweather.gov
# A METAR is issued every hour (specials in between), so 5 minutes already sees movement.
AVIATION_CACHE_TTL=300
AVIATION_HTTP_TIMEOUT=20

# --- state -------------------------------------------------------------------
AVIATION_DB=./servers/aviation/data/tasks.db
# A flight category changes on the scale of an hour or two; 300s polls keep up politely.
AVIATION_WATCH_INTERVAL=300
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
AVIATION_ALLOW_PRIVATE_WEBHOOKS=0
