[TEMPLATE]
# Open-Meteo air-quality A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8797
A2A_PUBLIC_URL=http://127.0.0.1:8797
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# Open-Meteo needs no key; this is just how you identify yourself.
AIR_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
AIR_BASE_URL=https://air-quality-api.open-meteo.com
# The model updates hourly, so a 5-minute cache is already generous.
AIR_CACHE_TTL=300
AIR_HTTP_TIMEOUT=20

# --- state -------------------------------------------------------------------
AIR_DB=./servers/air/data/tasks.db
# Watches read the current hour; 900s keeps the polling well inside the free tier.
AIR_WATCH_INTERVAL=900
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
AIR_ALLOW_PRIVATE_WEBHOOKS=0
