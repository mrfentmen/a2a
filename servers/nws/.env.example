# NWS weather-alerts A2A server — copy to .env and export.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8791
A2A_PUBLIC_URL=http://127.0.0.1:8791
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# NWS asks for a User-Agent that identifies you and gives them a way to contact you.
# Set this to your own URL or email before running a public deployment.
NWS_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
NWS_BASE_URL=https://api.weather.gov
NWS_CACHE_TTL=60
NWS_HTTP_TIMEOUT=20

# --- state -------------------------------------------------------------------
NWS_DB=./servers/nws/data/tasks.db
# Weather alerts are event-shaped: 300s keeps a watch responsive without hammering NWS.
NWS_WATCH_INTERVAL=300
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
NWS_ALLOW_PRIVATE_WEBHOOKS=0
