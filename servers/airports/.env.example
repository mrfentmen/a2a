[TEMPLATE]
# FAA airport status A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8801
A2A_PUBLIC_URL=http://127.0.0.1:8801
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# The FAA status feed needs no key; this is just how you identify yourself.
FAA_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
FAA_BASE_URL=https://www.fly.faa.gov
# The snapshot is revised every few minutes, so a short cache still sees movement.
FAA_CACHE_TTL=120
FAA_HTTP_TIMEOUT=20

# --- state -------------------------------------------------------------------
FAA_DB=./servers/airports/data/tasks.db
# Delay programs appear and clear on the scale of a few minutes; 120s polls keep up politely.
FAA_WATCH_INTERVAL=120
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
FAA_ALLOW_PRIVATE_WEBHOOKS=0
