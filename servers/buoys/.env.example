[TEMPLATE]
# NOAA NDBC buoy A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8800
A2A_PUBLIC_URL=http://127.0.0.1:8800
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# NDBC needs no key; this is just how you identify yourself.
BUOY_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
BUOY_BASE_URL=https://www.ndbc.noaa.gov
# Observations arrive every 10-60 minutes, so a 5-minute cache never hides a fresh reading.
BUOY_CACHE_TTL=300
BUOY_HTTP_TIMEOUT=30
# english (mph / ft / °F / inHg, the default) or metric (m/s / m / °C / hPa, as NDBC publishes)
BUOY_UNITS=english

# --- state -------------------------------------------------------------------
BUOY_DB=./servers/buoys/data/tasks.db
# Mostly-hourly observations: 900s polls the newest reading without leaning on NDBC.
BUOY_WATCH_INTERVAL=900
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
BUOY_ALLOW_PRIVATE_WEBHOOKS=0
