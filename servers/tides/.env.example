# NOAA tides A2A server — copy to .env and export, or pass as real env vars.

# --- listening ---------------------------------------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8793
A2A_PUBLIC_URL=http://127.0.0.1:8793
A2A_LOG_LEVEL=INFO

# --- card metadata (optional) ------------------------------------------------
A2A_PROVIDER_ORG=
A2A_PROVIDER_URL=

# --- upstream API ------------------------------------------------------------
# NOAA asks callers to identify themselves; override with your own contact URL.
NOAA_TIDES_USER_AGENT=a2a-kit/1.0 (+https://github.com/mrfentmen/a2a)
NOAA_TIDES_BASE_URL=https://api.tidesandcurrents.noaa.gov
NOAA_TIDES_CACHE_TTL=60
NOAA_TIDES_HTTP_TIMEOUT=20
# english = feet, metric = metres. Flood stages are published in feet either way.
NOAA_TIDES_UNITS=english
# Datum heights are reported against: MLLW, MSL, NAVD, STND or MHHW.
NOAA_TIDES_DATUM=MLLW
# The station catalogue is about 2 MB and changes rarely: cache it for a day.
NOAA_TIDES_STATION_TTL=86400

# --- state -------------------------------------------------------------------
NOAA_TIDES_DB=./servers/tides/data/tasks.db
# Water levels move continuously; 300s is responsive without hammering NOAA.
NOAA_TIDES_WATCH_INTERVAL=300
# 1 allows webhook URLs pointing at private/loopback addresses (local demos only).
NOAA_TIDES_ALLOW_PRIVATE_WEBHOOKS=0
